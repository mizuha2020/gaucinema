{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "wtPresence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid"
      }
    },
    "sessions": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "$slot": {
          ".validate": "$slot === '1' || $slot === '2'"
        }
      }
    },
    "activeSessions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "system_cache": {
      ".read": "auth != null",
      ".write": false
    },
    "appConfig": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
