rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data; }
    function isAdmin() { return isSignedIn() && me().role == 'admin'; }

    // Tài khoản: document id PHẢI là Firebase Auth uid.
    match /accounts/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      // Admin toàn quyền. Chính chủ được sửa nhưng CẤM đụng role, status, uid.
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.uid == resource.data.uid);
    }

    // Hồ sơ: slot cố định p1/p2 — hồ sơ thứ 3 KHÔNG THỂ tạo được ở tầng
    // database, kể cả gọi Firestore SDK từ DevTools.
    // LƯU Ý: không dùng match /{sub=**} chung ở đây — rules cộng dồn theo OR,
    // một wildcard cho phép create sẽ vô hiệu hóa chặn p1/p2 phía trên.
    match /accounts/{uid}/profiles/{profileId} {
      allow create: if (request.auth.uid == uid || isAdmin()) && (profileId == 'p1' || profileId == 'p2');
      allow read, update, delete: if request.auth.uid == uid || isAdmin();
    }

    // Dữ liệu dưới mỗi hồ sơ (history, myList, savedManga, mangaHistory,
    // youtubeFavorites, youtubeHistory, youtubeSubscriptions...):
    // chỉ chính chủ hoặc admin.
    match /accounts/{uid}/profiles/{profileId}/{rest=**} {
      allow read, write: if request.auth.uid == uid || isAdmin();
    }

    // Thống kê và lịch sử hoạt động: client ghi, chỉ admin đọc.
    match /userStats/{id} {
      allow create, update: if isSignedIn();
      allow read: if isAdmin();
    }
    match /userActivityHistory/{id} {
      allow create, update: if isSignedIn();
      allow read: if isAdmin();
    }

    // Phiên xem trực tuyến (presence).
    match /activeSessions/{id} {
      allow create, update, delete, read: if isSignedIn();
    }

    // Dữ liệu dùng chung: ai đăng nhập cũng đọc được, chỉ admin ghi.
    match /system_apis/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /customAvatars/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /global/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /system_cache/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Mã ghép đôi TV.
    match /tvPairCodes/{code} {
      allow read, write: if isSignedIn();
    }
  }
}
