rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for document ID length validation
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Accounts collection
    match /accounts/{accountId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(accountId);

      // Subcollection: Profiles (up to 5 per account)
      match /profiles/{profileId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(profileId);

        // Subcollection: My List (Watchlist per profile)
        match /myList/{movieSlug} {
          allow get, list: if true;
          allow create, update, delete: if isValidId(movieSlug);
        }

        // Subcollection: Watch History per profile
        match /history/{historyId} {
          allow get, list: if true;
          allow create, update, delete: if isValidId(historyId);
        }
      }
    }

    // Custom Avatars collection
    match /customAvatars/{avatarId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(avatarId);
    }

    // Global configurations (e.g. tv_config)
    match /global/{configId} {
      allow get, list, create, update: if true;
    }
  }
}

