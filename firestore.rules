rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for document ID length validation
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Accounts collection and all subcollections (profiles, myList, history)
    match /accounts/{document=**} {
      allow read, write: if true;
    }

    // Custom Avatars collection
    match /customAvatars/{avatarId} {
      allow read, write: if true;
    }

    // Global configurations (e.g. tv_config)
    match /global/{configId} {
      allow read, write: if true;
    }
    
    // Default deny for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

