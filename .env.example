# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: Required for Capacitor (Android/iOS) apps to connect to the backend.
# Set this to your app's public URL (e.g. https://ais-dev-...run.app)
# in the AI Studio Secrets panel.
VITE_API_URL="MY_APP_URL"

# VITE_APK_URL: Link file APK cho mục "Tải APK cho TV" trong app.
# Mặc định trỏ Release tự động (branch tv build xong tự gắn APK vào tag tv-apk).
# Chỉ cần set khi muốn dùng link khác (VD: Firebase Storage).
# VITE_APK_URL="https://github.com/mizuha2020/qtb-movie/releases/download/tv-apk/app-debug.apk"

# --- Prompt 7: cơ chế cập nhật APK ---
# CAPACITOR_SERVER_URL: URL production cho tầng web của APK (đọc lúc `npx cap sync`).
# Có nó, APK tải web từ server mỗi lần mở -> sửa web chỉ deploy server, khỏi build lại APK.
# Để trống khi dev để dùng web nhúng (webDir) như cũ.
# CAPACITOR_SERVER_URL="https://<domain-production-cua-toi>"

# GET /api/app/version đọc 4 biến dưới (đổi là restart backend, không tốn Firestore reads).
# Mặc định = versionCode/versionName hiện tại trong android/app/build.gradle
# nên chưa có gì để báo cho tới khi bạn nâng số.
# APP_LATEST_VERSION_CODE="1"
# APP_LATEST_VERSION_NAME="1.0"
# APP_MIN_SUPPORTED_VERSION_CODE="1"
# APP_APK_URL="https://github.com/mizuha2020/qtb-movie/releases/download/tv-apk/app-debug.apk"
# APP_RELEASE_NOTES="Sửa lỗi đăng nhập"

