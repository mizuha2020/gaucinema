{
  "entities": {
    "Account": {
      "title": "Account",
      "description": "User account created by Admin with login credentials and role",
      "type": "object",
      "properties": {
        "username": { "type": "string", "minLength": 2, "maxLength": 64 },
        "password": { "type": "string", "minLength": 4, "maxLength": 64 },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "displayName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "blocked"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["username", "password", "role", "displayName", "status", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profile associated with an account (up to 5 profiles per account)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "avatar": { "type": "string", "maxLength": 2048 },
        "color": { "type": "string", "maxLength": 32 },
        "isKid": { "type": "boolean" },
        "pin": { "type": "string", "maxLength": 8 },
        "isPrimary": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "avatar", "color", "createdAt"]
    },
    "MyListItem": {
      "title": "MyListItem",
      "description": "A saved movie item in user profile's private watchlist",
      "type": "object",
      "properties": {
        "movieSlug": { "type": "string", "maxLength": 128 },
        "movieName": { "type": "string", "maxLength": 256 },
        "movieOriginName": { "type": "string", "maxLength": 256 },
        "movieThumb": { "type": "string", "maxLength": 2048 },
        "moviePoster": { "type": "string", "maxLength": 2048 },
        "year": { "type": "number" },
        "quality": { "type": "string", "maxLength": 64 },
        "lang": { "type": "string", "maxLength": 64 },
        "episode_current": { "type": "string", "maxLength": 64 },
        "addedAt": { "type": "number" }
      },
      "required": ["movieSlug", "movieName", "movieThumb", "addedAt"]
    },
    "WatchHistoryItem": {
      "title": "WatchHistoryItem",
      "description": "Playback progress and watch history record for a profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "movieSlug": { "type": "string", "maxLength": 128 },
        "movieName": { "type": "string", "maxLength": 256 },
        "movieOriginName": { "type": "string", "maxLength": 256 },
        "movieThumb": { "type": "string", "maxLength": 2048 },
        "moviePoster": { "type": "string", "maxLength": 2048 },
        "episodeName": { "type": "string", "maxLength": 128 },
        "episodeSlug": { "type": "string", "maxLength": 128 },
        "serverName": { "type": "string", "maxLength": 128 },
        "linkM3u8": { "type": "string", "maxLength": 2048 },
        "currentTime": { "type": "number" },
        "duration": { "type": "number" },
        "progressPercent": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "movieSlug", "movieName", "movieThumb", "episodeName", "episodeSlug", "serverName", "currentTime", "duration", "progressPercent", "updatedAt"]
    },
    "CustomAvatar": {
      "title": "CustomAvatar",
      "description": "Custom avatar uploaded and managed by Admin for users to choose",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "url": { "type": "string", "maxLength": 2048 },
        "name": { "type": "string", "maxLength": 100 },
        "addedBy": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "url", "name", "createdAt"]
    },
    "SystemApiEndpoint": {
      "title": "SystemApiEndpoint",
      "description": "System API configurations managed by admin for movies, manga, livetv and utility services",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["movie", "manga", "livetv", "utility"] },
        "baseUrl": { "type": "string", "maxLength": 2048 },
        "testUrl": { "type": "string", "maxLength": 2048 },
        "description": { "type": "string", "maxLength": 500 },
        "enabled": { "type": "boolean" },
        "isDefault": { "type": "boolean" },
        "priority": { "type": "number" },
        "lastChecked": { "type": "number" },
        "lastLatencyMs": { "type": "number" },
        "lastStatusCode": { "type": "number" },
        "lastStatus": { "type": "string", "enum": ["live", "slow", "down"] },
        "lastErrorMessage": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "category", "baseUrl", "testUrl", "enabled", "lastStatus"]
    },
    "ActiveViewerSession": {
      "title": "ActiveViewerSession",
      "description": "Realtime active viewing/reading presence session for users",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128 },
        "accountId": { "type": "string", "maxLength": 64 },
        "accountDisplayName": { "type": "string", "maxLength": 100 },
        "profileId": { "type": "string", "maxLength": 64 },
        "profileName": { "type": "string", "maxLength": 64 },
        "profileAvatar": { "type": "string", "maxLength": 2048 },
        "type": { "type": "string", "enum": ["watching_movie", "reading_manga", "watching_tv", "browsing"] },
        "itemTitle": { "type": "string", "maxLength": 256 },
        "itemSubtitle": { "type": "string", "maxLength": 256 },
        "itemCover": { "type": "string", "maxLength": 2048 },
        "apiSourceUsed": { "type": "string", "maxLength": 64 },
        "progressPercent": { "type": "number" },
        "currentTime": { "type": "number" },
        "duration": { "type": "number" },
        "lastHeartbeat": { "type": "number" },
        "deviceInfo": { "type": "string", "maxLength": 128 }
      },
      "required": ["sessionId", "accountId", "profileId", "type", "itemTitle", "lastHeartbeat"]
    },
    "YouTubeFavoriteItem": {
      "title": "YouTubeFavoriteItem",
      "description": "Saved favorite YouTube video per profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 256 },
        "channelTitle": { "type": "string", "maxLength": 256 },
        "channelId": { "type": "string", "maxLength": 128 },
        "channelAvatar": { "type": "string", "maxLength": 2048 },
        "thumbnailUrl": { "type": "string", "maxLength": 2048 },
        "publishedAt": { "type": "string", "maxLength": 128 },
        "duration": { "type": "string", "maxLength": 64 },
        "viewCount": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 1000 },
        "addedAt": { "type": "number" }
      },
      "required": ["id", "title", "channelTitle", "thumbnailUrl", "addedAt"]
    },
    "YouTubeHistoryItem": {
      "title": "YouTubeHistoryItem",
      "description": "YouTube watch history record per profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 256 },
        "channelTitle": { "type": "string", "maxLength": 256 },
        "channelId": { "type": "string", "maxLength": 128 },
        "channelAvatar": { "type": "string", "maxLength": 2048 },
        "thumbnailUrl": { "type": "string", "maxLength": 2048 },
        "publishedAt": { "type": "string", "maxLength": 128 },
        "duration": { "type": "string", "maxLength": 64 },
        "viewCount": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "channelTitle", "thumbnailUrl", "updatedAt"]
    },
    "YouTubeSubscriptionItem": {
      "title": "YouTubeSubscriptionItem",
      "description": "Subscribed YouTube channel per profile",
      "type": "object",
      "properties": {
        "channelId": { "type": "string", "maxLength": 128 },
        "channelTitle": { "type": "string", "maxLength": 256 },
        "channelAvatar": { "type": "string", "maxLength": 2048 },
        "subscribedAt": { "type": "number" }
      },
      "required": ["channelId", "subscribedAt"]
    }
  },
  "firestore": {
    "/accounts/{accountId}": {
      "schema": "Account",
      "description": "User accounts with credentials, role and status"
    },
    "/accounts/{accountId}/profiles/{profileId}": {
      "schema": "UserProfile",
      "description": "User profiles under each account (max 5 per account)"
    },
    "/accounts/{accountId}/profiles/{profileId}/myList/{movieSlug}": {
      "schema": "MyListItem",
      "description": "Watchlist specific to a single profile"
    },
    "/accounts/{accountId}/profiles/{profileId}/history/{historyId}": {
      "schema": "WatchHistoryItem",
      "description": "Watch history specific to a single profile"
    },
    "/accounts/{accountId}/profiles/{profileId}/youtubeFavorites/{videoId}": {
      "schema": "YouTubeFavoriteItem",
      "description": "YouTube saved favorite videos specific to a single profile"
    },
    "/accounts/{accountId}/profiles/{profileId}/youtubeHistory/{videoId}": {
      "schema": "YouTubeHistoryItem",
      "description": "YouTube watch history specific to a single profile"
    },
    "/accounts/{accountId}/profiles/{profileId}/youtubeSubscriptions/{channelId}": {
      "schema": "YouTubeSubscriptionItem",
      "description": "YouTube channel subscriptions specific to a single profile"
    },
    "/customAvatars/{avatarId}": {
      "schema": "CustomAvatar",
      "description": "Gallery of custom avatars managed by admin"
    },
    "/system_apis/{apiId}": {
      "schema": "SystemApiEndpoint",
      "description": "Dynamic system API configurations for entire app runtime"
    },
    "/activeSessions/{sessionId}": {
      "schema": "ActiveViewerSession",
      "description": "Realtime active viewer presence heartbeat sessions"
    }
  }
}
